<script>
  var myip = '0.0.0.0';
            fetch('https://api.ipify.org?format=json')
            .then(response => response.json())
            .then(async data =>  {
                myip = data.ip;
                const docip = document.getElementById('myip');
                const docmycomments = document.getElementById('mycomments');
                docip.innerHTML = myip; 
                docmycomments.href = "/user/" + myip;
            })
            .catch(error => console.error('에러 발생:', error));
</script>
