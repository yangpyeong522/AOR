<%- include('head.ejs') %>
<body>
    <%- include('navbar.ejs') %>
    <div class="container mt-5">
        <form action="/edit?_method=PUT" method="POST">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" name="_id" id="floatingtitle" placeholder="문제번호" value="<%=edits._id%>" readonly>
                <label for="floatingtitle">문제번호</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control" name="tears" id="tears" placeholder="문제티어" value="<%=edits.tearbig%> <%=edits.tearsmall%>" readonly>
                <label for="floatingtitle">문제티어</label>
            </div>
            <div class="form-floating mb-3">
                <input type="text" class="form-control" name="name" id="name" placeholder="문제제목" value="<%=edits.name%>" readonly>
                <label for="floatingtitle">문제제목</label>
            </div>
            <div class="form-floating mb-3">
                <textarea class="form-control" id="textarea1" style="height: 200px;" placeholder="" name="answer"><%=edits.answer%></textarea>
                <label for="textarea1" class="form-label">문제 풀이</label>
            </div>
            <div class="form-floating mb-3">
                <textarea class="form-control" id="textarea2" name="testcase" placeholder="" style="height: 200px;"><%=edits.testcase%></textarea>
                <label for="textarea2" class="form-label">테스트케이스들</label>
            </div>
            <button type="submit" class="btn btn-primary" id="liveToastBtn">올리기</button>
        </form>
    </div>
        
    <%- include('footer.ejs') %>
</body>
<script src="/js/searchbox.js"></script>
<script src="/js/header.js"></script>
</html>