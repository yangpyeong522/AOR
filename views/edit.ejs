<%- include('head.ejs') %>
<body>
    <%- include('navbar.ejs') %>
    <div class="container-fluid heading" id="heading">
        <div class="container d-flex h-100 align-items-center ">
            <div>  
                <div class="d-flex align-items-center"> <h1 class="me-2">
                    <%=comments.problem_id%> <%=comments.title%> 
                </h1>
                <h3> <% if(version.isversion){ %>
                    (<%=version.version%> 버전에 대한 수정)
                <% } %></h3></div>
           
               
            <span class="text-secondary"><%=comments.tearbig%> <%=comments.tearsmall%> · 해당 버전 수정 시각: <%=formatDate(version.when)%>  · 전 작성자 : <a href="/user/<%=version.ip%>"><%=version.ip%></a></span>
            </div>
        </div>
    </div>
    <div class="w-100 pt-0" >
        <div id="toolbar" class="container mt-4 d-flex flex-nowrap align-items-center">
            <!-- flex-fill: 남는 공간만 차지, min-width:0 으로 너무 커지는 텍스트 제어 -->
            <div class="flex-fill border border-dark-subtle rounded-3 me-2 p-2" style="min-width: 0;">
                분류 : <%= comments.tags %>
            </div>

            <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                <!-- <button type="button" class="btn btn-danger"><i class="bi bi-trash3-fill"></i> &nbsp; 삭제</button> -->
                <button type="button" id="goback" class="btn btn-warning" style="color: white;"><i class="bi bi-x-circle-fill"></i> &nbsp; 취소</button>
                <button type="button" id="saver" class="btn btn-success"><i class="bi bi-check-circle-fill"></i> &nbsp; 저장</button>
            </div>
        </div>
        <div id="editor" class="no-noto container mt-3">
                
        </div>
    </div>
    <%- include('footer.ejs') %>
    <div class="toast-container">
        <div id="errorToast" class="toast align-items-center border-danger rounded-pill" role="alert" aria-live="assertive" aria-atomic="true">
          <div class="d-flex">
            <div class="toast-body d-flex align-items-center" id="toastMessage">
              에러가 발생했습니다.
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      </div>
      <div class="toast-container">
        <div id="successToast" class="toast align-items-center border-success rounded-pill" role="alert" aria-live="assertive" aria-atomic="true">
          <div class="d-flex">
            <div class="toast-body d-flex align-items-center" id="toastSMessage">
              성공적으로 수행했습니다.
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      </div>
</body>
<script src="/js/searchbox.js"></script>
<script src="/js/header.js"></script>
<script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
<script>
            let heading = document.getElementById("heading");
            let rank ="<%=comments.tearbig%>";
            // 티어별 연한(파스텔) 그라디언트 컬러 맵
            const gradientMap = {
                "Bronze": ["#ffe6cc", "#ffd5b2"],   // 더 연한 브론즈 톤
                "Silver": ["#dce7ef", "#ebf3f8"],   // 더 연한 실버 톤
                "Gold": ["#fff4d9", "#fff9e6"],     // 더 연한 골드 톤
                "Platinum": ["#e3fef4", "#edfef8"], // 더 연한 플래티넘 톤
                "Diamond": ["#d9f2ff", "#ecf8ff"],  // 더 연한 다이아 톤
                "Ruby": ["#ffd1e4", "#ffe0ec"]      // 더 연한 루비 톤
            };

            // default (해당 티어가 없을 때 적용할 연한 색상)
            const defaultGradient = ["#b3f0ff", "#e6fcff"];

            // rank에 해당하는 색상 배열을 가져오고, 없으면 defaultGradient 사용
            const [startColor, endColor] = gradientMap[rank] || defaultGradient;

            // 그라디언트 배경 적용
            heading.style.background = `linear-gradient(to right, ${startColor}, ${endColor})`;

            // 서버에서 넘겨준 doc 변수를 JS 문자열로 안전하게 파싱
            const markdown = <%- JSON.stringify(version.doc) %>;
            const editor = new toastui.Editor({
                el: document.querySelector('#editor'),
                height: '500px',
                initialEditType: 'markdown',
                previewStyle: 'vertical',
                initialValue: markdown    // ← 여기에 초기 텍스트 지정
            });

            document.getElementById('goback').addEventListener('click',()=>{
                history.back();
            });
            document.getElementById('saver').addEventListener('click', async ()=>{
                const writing_doc = editor.getMarkdown();

                const res = await fetch('/api/version', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ problem_id: <%- comments.problem_id %> , doc: writing_doc }),
                }).then(async response => {
                    if (!response.ok) {
                        // JSON 형식의 에러 메시지를 받도록 시도
                        const errorData = await response.json().catch(() => ({}));
                        throw new Error(`${response.status} ${errorData.error}`);
                    }
                    return response.json();
                }).then(data => {
                    document.getElementById('toastSMessage').innerHTML = 
                        `<i class="bi bi-check2-circle me-2"></i>` + `<span class="my-auto">${data.version}을 성공적으로 추가했습니다.</span>`;
                
                    var toastElement = document.getElementById('successToast');
                    var toast = new bootstrap.Toast(toastElement);
                    toast.show();
                    window.location.href = `/comment/${data.version}`;
                })
                .catch(error => {
                    document.getElementById('toastMessage').innerHTML = 
                    `<i class="bi bi-x-circle me-2"></i>` + `<span class="my-auto">${error.message}</span>`;
                    console.log(error.message);
                    var toastElement = document.getElementById('errorToast');
                    var toast = new bootstrap.Toast(toastElement);
                    toast.show();
                });
            });
</script>
</html>