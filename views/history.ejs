<%- include('head.ejs') %>
<body>
    <%- include('navbar.ejs') %>
    <div class="container-fluid heading" id="heading">
        <div class="container d-flex h-100 align-items-center ">
            <div>  
            <h1>
                <%=comments.problem_id%> <%=comments.title%>
            </h1>
            <span class="text-secondary"><%=comments.tearbig%> <%=comments.tearsmall%></a></span>
            </div>
        </div>
    </div>
    <div class="w-100 pt-0" >
        <div id="toolbar" class="container mt-4 d-flex flex-nowrap align-items-center">
            <!-- flex-fill: 남는 공간만 차지, min-width:0 으로 너무 커지는 텍스트 제어 -->
            <div class="flex-fill border border-dark-subtle rounded-3 me-2 p-2" style="min-width: 0;">
                분류 : <%= comments.tags %>
            </div>

            <!-- flex-shrink-0: 버튼 그룹이 축소되지 않음 -->
            <div class="btn-group flex-shrink-0" role="group">
                <a type="button" href="/edit/version/<%=comments.problem_id%>/<%=version[0].version%>" class="btn btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> 편집
                </a>
            </div>
        </div>
        <div id="historybox" class="container mt-4">
            <ul>
                <% version.forEach(function(ver, idx) { %>
                    <li><span><%=formatDate(ver.when)%> ( <a href="/comment/version/<%=comments.problem_id%>/<%=ver.version%>">보기</a> | <a href="/edit/version/<%=comments.problem_id%>/<%=ver.version%>">이 버전에서 수정하기</a>) <strong>버전<%=ver.version%></strong>/<strong><a href="/user/<%=ver.ip%>"><%=ver.ip%></a></strong> </span></li>
                  <% }); %>
                </ul>
        </div>
    </div>
    <%- include('footer.ejs') %>
</body>
<script src="/js/searchbox.js"></script>
<script src="/js/header.js"></script>
<script src="https://uicdn.toast.com/editor/latest/toastui-editor-viewer.min.js"></script>
<script>
            let heading = document.getElementById("heading");
            let rank ="<%=comments.tearbig%>";
            // 티어별 연한(파스텔) 그라디언트 컬러 맵
            const gradientMap = {
                "Bronze": ["#ffe6cc", "#ffd5b2"],   // 더 연한 브론즈 톤
                "Silver": ["#dce7ef", "#ebf3f8"],   // 더 연한 실버 톤
                "Gold": ["#fff4d9", "#fff9e6"],     // 더 연한 골드 톤
                "Platinum": ["#e3fef4", "#edfef8"], // 더 연한 플래티넘 톤
                "Diamond": ["#d9f2ff", "#ecf8ff"],  // 더 연한 다이아 톤
                "Ruby": ["#ffd1e4", "#ffe0ec"]      // 더 연한 루비 톤
            };

            // default (해당 티어가 없을 때 적용할 연한 색상)
            const defaultGradient = ["#b3f0ff", "#e6fcff"];

            // rank에 해당하는 색상 배열을 가져오고, 없으면 defaultGradient 사용
            const [startColor, endColor] = gradientMap[rank] || defaultGradient;

            // 그라디언트 배경 적용
            heading.style.background = `linear-gradient(to right, ${startColor}, ${endColor})`;

</script>
</html>